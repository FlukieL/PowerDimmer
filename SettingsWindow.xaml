<Window x:Class="PowerDimmer.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PowerDimmer" Title="PowerDimmer Settings" Width="860" Height="700" MinWidth="700" MinHeight="520" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#1E1E2E" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CB" TargetType="CheckBox"><Setter Property="Foreground" Value="#CDD6F4"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#6C7086"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="20,0,0,5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="H" TargetType="TextBlock"><Setter Property="Foreground" Value="#89B4FA"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,14,0,6"/></Style>
        <Style x:Key="Sep" TargetType="Separator"><Setter Property="Background" Value="#313244"/><Setter Property="Margin" Value="0,6"/><Setter Property="Height" Value="1"/></Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/><Setter Property="Foreground" Value="#1E1E2E"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="20,7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B4BEFE"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#74C7EC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource SmallBtn}"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="CaretBrush" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="ExceptionComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="ToolTip" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#585B70"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExceptionCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ExceptionComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#313244" BorderBrush="#585B70" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="&#x25BE;" Foreground="#CDD6F4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,4,30,4" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#313244" BorderBrush="#585B70" BorderThickness="1"
                                        Width="{Binding ActualWidth, ElementName=Root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
        </Style>
        <Style x:Key="BulbToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#F9E2AF"/>
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Sldr" TargetType="Slider">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Track x:Name="PART_Track" Grid.Row="1"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#45475A" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" Stroke="#1E1E2E" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#x26A1;" FontSize="20" Foreground="#F9E2AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="PowerDimmer" FontSize="18" FontWeight="Bold" Foreground="#CDD6F4"/>
                    <TextBlock Text="Settings" FontSize="11" Foreground="#6C7086"/>
                </StackPanel>
            </StackPanel>
            <ToggleButton x:Name="DimmingToggle" Grid.Column="1" Style="{StaticResource BulbToggle}" IsChecked="{Binding DimmingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Toggle dimming" AutomationProperties.Name="Toggle dimming">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4A1;" FontFamily="Segoe UI Symbol" FontSize="18" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="Dimming off" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </ToggleButton>
        </Grid>
        <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#313244" Margin="0,46,0,0"/>

        <!-- Brightness stays visible while the settings below scroll. -->
        <StackPanel Grid.Row="1" Margin="0,8,0,4">
            <TextBlock Style="{StaticResource H}" Text="BRIGHTNESS" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                <local:BrightnessInteractionSlider x:Name="BrightnessSlider" Grid.Column="0" Style="{StaticResource Sldr}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" VerticalAlignment="Center" Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" UserInteraction="BrightnessSlider_UserInteraction" AutomationProperties.Name="Brightness" ToolTip="Adjusting brightness enables dimming"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold" Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat={}{0:0}%}"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Higher = brighter (less dimming effect on background windows)."/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0" PanningMode="VerticalOnly">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">

                <TextBlock Style="{StaticResource H}" Text="DIMMING"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,5" Text="Dims all windows except the focused one. Use the lightbulb or configure a shortcut to toggle."/>
                <CheckBox Style="{StaticResource CB}" Content="Dim taskbar" IsChecked="{Binding DimTaskbar, Mode=TwoWay}" Margin="0,8,0,4">
                    <CheckBox.ToolTip>
                        <ToolTip><TextBlock Text="Keeps the taskbar below the dim overlay. May have no effect on Windows 11 due to taskbar rendering changes." MaxWidth="280" TextWrapping="Wrap"/></ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Style="{StaticResource CB}" Content="Dim title bar of focused window" IsChecked="{Binding DimTitleBar, Mode=TwoWay}" Margin="0,4"/>
                <TextBlock Style="{StaticResource Hint}" Text="Applies a dim overlay to the title bar (caption area) of the currently focused window, so it blends with the dimmed background. Note: may not cover correctly on apps with non-standard or custom-drawn title bars (e.g. borderless, Electron, or heavily themed windows)."/>
                <CheckBox Style="{StaticResource CB}" Content="Dim all monitors" IsChecked="{Binding MultiMonitorDimming, Mode=TwoWay}" Margin="0,4"/>
                <TextBlock Style="{StaticResource Hint}" Text="When off, only the primary monitor is dimmed."/>
                <CheckBox Style="{StaticResource CB}" Content="Undim on desktop click" IsChecked="{Binding UndimOnDesktop, Mode=TwoWay}" Margin="0,8,0,4"/>
                <TextBlock Style="{StaticResource Hint}" Text="Temporarily removes all dimming when you click the desktop wallpaper."/>

                <Separator Style="{StaticResource Sep}"/>

                <TextBlock Style="{StaticResource H}" Text="EXCEPTIONS"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="Keep selected windows undimmed when switching focus. Window exceptions last until closed; application exceptions persist."/>
                <ComboBox x:Name="OpenWindows" Style="{StaticResource ExceptionCombo}" MinHeight="32" ToolTip="Select an open window">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Margin="0,6,0,4">
                    <Button Content="Refresh" Click="RefreshWindows_Click" Padding="8,4" Margin="0,0,6,4"/>
                    <Button Content="Add window" Click="AddWindowException_Click" Padding="8,4" Margin="0,0,6,4"/>
                    <Button Content="Add its application" Click="AddWindowApplication_Click" Padding="8,4" Margin="0,0,0,4"/>
                </WrapPanel>
                <DockPanel Margin="0,2,0,6">
                    <Button DockPanel.Dock="Right" Content="Add application" Click="AddApplication_Click" Padding="8,4" Margin="6,0,0,0"/>
                    <TextBox x:Name="ApplicationName" MinHeight="28" ToolTip="Executable name, e.g. notepad.exe"/>
                </DockPanel>
                <ListBox x:Name="ExceptionList" Height="100" ToolTip="Select an exception to remove"/>
                <Button Content="Remove selected exception" Click="RemoveException_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,6,0,0"/>
                <Separator Style="{StaticResource Sep}"/>

                </StackPanel>
                <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource H}" Text="WINDOW SHADE"/>
                <CheckBox Style="{StaticResource CB}" Content="Window shade enabled" IsChecked="{Binding WindowShadeEnabled, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Manually apply a dark overlay to any individual window — useful for apps with no dark mode. Unlike dimming, the overlay stays on the chosen window regardless of focus."/>
                <TextBlock Style="{StaticResource Hint}" Text="Configure shortcuts below to toggle a shade or draw a custom region."/>

                <Separator Style="{StaticResource Sep}"/>

                <TextBlock Style="{StaticResource H}" Text="BEHAVIOUR"/>
                <CheckBox Style="{StaticResource CB}" Content="Active on launch" IsChecked="{Binding ActiveOnLaunch, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Start dimming automatically when the app launches."/>
                <CheckBox Style="{StaticResource CB}" Content="Start minimized to tray" IsChecked="{Binding StartMinimized, Mode=TwoWay}" Margin="0,8,0,4"/>
                <TextBlock Style="{StaticResource Hint}" Text="Launch without showing this window. Reopen via the tray icon."/>
                <CheckBox Style="{StaticResource CB}" Content="Minimize to tray" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Margin="0,8,0,4"/>
                <TextBlock Style="{StaticResource Hint}" Text="Clicking Minimize hides the window to the tray instead of the taskbar."/>
                <CheckBox Style="{StaticResource CB}" Content="Close to tray" IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="0,8,0,4"/>
                <TextBlock Style="{StaticResource Hint}" Text="Clicking the window's X button hides to tray instead of exiting. Uncheck to exit the app when the window is closed."/>

                <Separator Style="{StaticResource Sep}"/>

                <TextBlock Style="{StaticResource H}" Text="HOTKEYS"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="Enable each shortcut and select its keys. Only Toggle dimming is enabled by default."/>
                <StackPanel x:Name="HotkeyRows"/>

                <Separator Style="{StaticResource Sep}"/>
                <TextBlock Foreground="#6C7086" FontSize="11" Margin="0,4,0,8">
                    <Run Text="PowerDimmer  ·  "/>
                    <Hyperlink NavigateUri="https://github.com/FlukieL/PowerDimmer" RequestNavigate="GitHubLink_RequestNavigate" Foreground="#89B4FA">github.com/FlukieL/PowerDimmer</Hyperlink>
                </TextBlock>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText" Grid.Column="0" Foreground="#6C7086" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CloseButton" Style="{StaticResource Btn}" Content="Close" Click="CloseButton_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn}" Content="Exit" Click="ExitButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
